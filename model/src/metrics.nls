;; T07 - Metrics & KPI reporters

;; Chi reset 10 bien tich luy cua luot chay, giu nguyen cac bien ket qua DSS.
to reset-metrics
  set total-orders-created 0
  set total-orders-completed 0
  set total-orders-ontime 0
  set total-orders-late 0
  set total-energy-consumed 0
  set total-wait-ticks 0
  set total-broken-ticks 0
  set total-incidents-triggered 0
  set total-orders-reassigned 0
  set total-reassigned-completed 0
end

;; Khong cong trung total-wait-ticks va total-broken-ticks vi robot.nls da tang moi tick.
to update-metrics
  if total-energy-consumed < 0 [ set total-energy-consumed 0 ]
  if total-wait-ticks < 0 [ set total-wait-ticks 0 ]
  if total-broken-ticks < 0 [ set total-broken-ticks 0 ]
end

to-report kpi-avg-completion-time
  let done-orders orders with [
    order-status = "completed" and
    completed-tick >= 0
  ]
  if not any? done-orders [
    report sim-max-ticks
  ]
  report mean [max (list 0 (completed-tick - created-tick))] of done-orders
end

;; Mau so tinh ca don chua xong nhung da qua han de tranh bo don ton lam dep chi so.
to-report kpi-ontime-rate
  let due-or-done count orders with [
    order-status = "completed" or
    ticks > deadline-tick
  ]
  if due-or-done <= 0 [
    report 100
  ]
  let ontime-count count orders with [
    order-status = "completed" and
    completed-tick >= 0 and
    completed-tick <= deadline-tick
  ]
  report min (list 100 (max (list 0 ((ontime-count / due-or-done) * 100))))
end

;; Tra 9999 neu 0 don hoan thanh ma van con don ton chua giao.
to-report kpi-energy-per-order
  if total-orders-completed > 0 [
    report max (list 0 (total-energy-consumed / total-orders-completed))
  ]
  if any? orders with [order-status != "completed"] [
    report 9999
  ]
  report max (list 0 total-energy-consumed)
end

to-report kpi-load-balance
  if count robots <= 1 [
    report 1
  ]
  let loads [orders-done] of robots
  let avg-load mean loads
  if avg-load <= 0 [
    report 1
  ]
  let cv (standard-deviation loads) / avg-load
  report max (list 0 (min (list 1 (1 - cv))))
end

to-report kpi-resilience
  if ticks <= 0 or total-orders-created <= 0 [
    report 1
  ]
  let completion-ratio min (list 1 (max (list 0 (total-orders-completed / total-orders-created))))
  let budget (count robots) * ticks
  let uptime-ratio 1
  if budget > 0 [
    set uptime-ratio max (list 0 (min (list 1 (1 - ((total-wait-ticks + total-broken-ticks) / budget)))))
  ]
  report (0.5 * completion-ratio) + (0.5 * uptime-ratio)
end

to-report kpi-completed-orders
  report total-orders-completed
end

to-report kpi-pending-orders
  report count orders with [order-status != "completed"]
end

to-report kpi-late-rate
  report 100 - kpi-ontime-rate
end

to-report kpi-total-energy
  report max (list 0 total-energy-consumed)
end

to-report kpi-avg-wait-time
  if count robots <= 0 [
    report 0
  ]
  report (max (list 0 total-wait-ticks)) / (count robots)
end

to-report kpi-total-charges
  if not any? robots [
    report 0
  ]
  report sum [charge-count] of robots
end

to-report kpi-congestion-events
  report max (list 0 total-wait-ticks)
end

to-report kpi-recovery-rate
  if total-orders-reassigned <= 0 [
    report 100
  ]
  report min (list 100 (max (list 0 ((total-reassigned-completed / total-orders-reassigned) * 100))))
end

;; Tra ve list 6 phan tu dung thu tu hop dong cho T08:
;; [active-strategy Speed On-time Energy Balance Resilience]
to-report collect-current-kpi-snapshot
  report (list
    active-strategy
    kpi-avg-completion-time
    kpi-ontime-rate
    kpi-energy-per-order
    kpi-load-balance
    kpi-resilience
  )
end
