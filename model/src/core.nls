;; ============================================================
;; MODULE: CORE
;; Vai trò: Điều khiển quá trình khởi tạo và vòng lặp mô phỏng.
;; Các procedure trong file này được gọi từ Interface và
;; BehaviorSpace.
;; ============================================================


;; Khởi tạo lại toàn bộ mô hình từ trạng thái ban đầu.
;; Khởi tạo đầy đủ môi trường, robot, KPI và trạng thái mô phỏng.
to setup
  clear-all

  ;; Khởi tạo vùng lưu kết quả DSS khi bắt đầu một mô hình hoàn toàn mới.
  set comparison-results []
  set normalized-results []
  set strategy-ranking []
  set recommended-strategy ""
  set recommendation-reason ""
  set trade-off-warning ""
  set decision-summary-data []

  ;; Thiết lập seed để có thể tái tạo chính xác cùng một lượt mô phỏng.
  set current-run-seed sim-seed
  random-seed sim-seed

  ;; Áp dụng bộ tham số tương ứng với kịch bản người dùng đã chọn.
  apply-scenario-preset scenario-preset
  apply-goal-weights

  ;; Khởi tạo bản đồ và đưa toàn bộ ô về trạng thái ban đầu.
  setup-environment

  ;; Tạo đội robot theo cấu hình num-robots.
  setup-robots

  ;; Đưa toàn bộ bộ đếm KPI về trạng thái ban đầu.
  reset-metrics

  ;; Thông báo mô hình đã khởi tạo xong và sẵn sàng chạy.
  set model-status "Ready"

  ;; Đưa bộ đếm thời gian mô phỏng về tick 0.
  reset-ticks
end

  ;; Thực hiện một bước thời gian của mô hình.
  ;; Điều phối các module theo đúng chu kỳ xử lý của mỗi tick.
to go
  ;; Dừng lượt mô phỏng khi đã đạt giới hạn tick cấu hình.
  if ticks >= sim-max-ticks [
    set model-status "Done"
    stop
  ]

  ;; Cập nhật trạng thái để Interface biết mô hình đang chạy.
  set model-status "Running"

  ;; Phát sinh đơn hàng mới theo order-spawn-rate.
  generate-orders

  ;; Kích hoạt, cập nhật và kết thúc các sự cố trong kho.
  update-incidents

  ;; Phân công các đơn đang chờ cho robot phù hợp.
  assign-unassigned-orders

  ;; Tính lại mức tắc nghẽn trên từng ô.
  update-congestion

  ;; Cập nhật trạng thái, đường đi, pin và chuyển động của robot.
  update-robots

  ;; Cập nhật đơn hoàn thành, đúng hạn và trễ hạn.
  update-orders

  ;; Cập nhật, bảo vệ và tổng hợp các chỉ số KPI.
  update-metrics

  ;; Tăng bộ đếm thời gian mô phỏng thêm một tick.
  tick

  ;; Kết thúc ngay khi vừa đạt giới hạn mô phỏng.
  if ticks >= sim-max-ticks [
    set model-status "Done"
    stop
  ]
end

;; Khởi tạo lại toàn bộ mô hình theo cấu hình hiện tại.
to reset-model
  setup
end

;; Kiểm tra các tham số chính có nằm trong phạm vi hợp lệ hay không.
to-report validate-configuration
  if num-robots < 2 or num-robots > 20 [ report false ]
  if order-spawn-rate < 0.05 or order-spawn-rate > 1 [ report false ]
  if priority-order-ratio < 0 or priority-order-ratio > 0.8 [ report false ]
  if initial-battery < 30 or initial-battery > 100 [ report false ]
  if sim-max-ticks < 100 [ report false ]

  report true
end
;; Chuẩn bị một lượt chạy mới nhưng vẫn giữ kết quả của các lượt trước.
to setup-for-strategy [strat seed-val]
  ;; Chỉ xóa tác tử, bản đồ và biểu đồ; không xóa kết quả DSS.
  clear-turtles
  clear-patches
  clear-drawing
  clear-all-plots
  reset-ticks

  ;; Ghi nhận chiến lược và seed của lượt chạy.
  set active-strategy strat
  set sim-seed seed-val
  set current-run-seed seed-val
  random-seed seed-val

  ;; Áp dụng lại cùng kịch bản để các chiến lược được so sánh công bằng.
  apply-scenario-preset scenario-preset
  apply-goal-weights

  ;; Đặt lại toàn bộ KPI của lượt chạy nhưng giữ kết quả DSS cũ.
  reset-metrics

  ;; Tạo lại bản đồ nhưng vẫn giữ kết quả so sánh các chiến lược.
  setup-environment

  ;; Tạo lại đội robot cho lượt chạy chiến lược mới.
  setup-robots

  set model-status "Ready"
end

;; Chạy hoàn chỉnh một chiến lược cho đến giới hạn thời gian mô phỏng.
to run-single-strategy-to-end [strat seed-val]
  ;; Chuẩn bị lượt chạy với chiến lược và seed được yêu cầu.
  setup-for-strategy strat seed-val

  ;; Thực hiện mô phỏng liên tục cho đến giới hạn tick.
  while [ticks < sim-max-ticks] [
    go
  ]

  ;; Đánh dấu lượt mô phỏng đã hoàn thành.
  set model-status "Done"
end