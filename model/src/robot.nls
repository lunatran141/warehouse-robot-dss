
;; MODULE: ROBOT
;; TASK: T04 - Robot & Battery
;; OWNER: TV2

;; Initialize robots.
to setup-robots
  let spawn-patches patches with [
    member? patch-type ["aisle" "waiting-zone"] and
    not is-blocked?
  ]

  if not any? spawn-patches [
    error "No valid robot spawn patches."
  ]

  create-robots num-robots [
    set robot-state "idle"
    set battery initial-battery
    set energy-used 0

    set current-order nobody
    set target-patch nobody

    set orders-done 0
    set distance-traveled 0
    set wait-ticks 0
    set active-ticks 0
    set charge-count 0
    set broken-until 0
    set wait-streak 0

    move-to one-of spawn-patches

    set shape "circle"
    set size 1

    update-robot-visuals
  ]
end


;; Update robot color and battery label.
to update-robot-visuals
  if robot-state = "idle" [
    set color gray
  ]

  if member? robot-state ["assigned" "to-pickup"] [
    set color blue
  ]

  if robot-state = "carrying" [
    set color cyan
  ]

  if robot-state = "waiting" [
    set color orange
  ]

  if robot-state = "charging" [
    set color lime
  ]

  if robot-state = "broken" [
    set color red
  ]

  set label (word (precision battery 0) "%")
  set label-color white
end


;; Return robots that are ready to receive an order.
to-report available-robots
  report robots with [
    robot-state = "idle" and
    not is-low-battery? and
    current-order = nobody
  ]
end

;; Assign an order to an available robot.
to assign-task [ord]
  ;; Validate robot and order.
  if ord = nobody [ stop ]
  if robot-state != "idle" [ stop ]
  if is-low-battery? [ stop ]
  if current-order != nobody [ stop ]

  if [order-status] of ord != "waiting" [ stop ]
  if [assigned-robot] of ord != nobody [ stop ]
  if [pickup-patch] of ord = nobody [ stop ]
  if [delivery-patch] of ord = nobody [ stop ]

  ;; Update robot information.
  set current-order ord
  set target-patch [pickup-patch] of ord
  set robot-state "assigned"
  set wait-streak 0

  ;; Update order information.
  ask ord [
    set order-status "assigned"
    set assigned-robot myself
  ]

  update-robot-visuals
end

;; Update all robots once per simulation tick.
to update-robots
  ask robots [
    update-one-robot
    update-robot-visuals
  ]
end



;; Process the current state of a robot.
to update-one-robot

  ;; Broken: wait until the repair time expires.
  if robot-state = "broken" [

    if ticks < broken-until [
      set total-broken-ticks total-broken-ticks + 1
      stop
    ]

    ;; A depleted robot requires recovery to a charger.
    if battery <= 0 [
      let charger nearest-charger-patch

      if charger = nobody [
        set total-broken-ticks total-broken-ticks + 1
        stop
      ]

      move-to charger
      set charge-count charge-count + 1
      set target-patch charger
      set robot-state "charging"
      set broken-until 0
      set wait-streak 0
      stop
    ]

    ;; Recover from a normal breakdown.
    set broken-until 0
    set target-patch nobody
    set wait-streak 0
    set robot-state "idle"

    if is-low-battery? [
      send-to-charger
    ]

    stop
  ]

  ;; Idle: check battery.
  if robot-state = "idle" [
    if is-low-battery? [
      send-to-charger
    ]
    stop
  ]

  ;; Assigned: prepare to collect the order.
  if robot-state = "assigned" [
    if current-order = nobody [
      set robot-state "idle"
      set target-patch nobody
      stop
    ]

    set target-patch [pickup-patch] of current-order
    set robot-state "to-pickup"
    stop
  ]

  ;; Move toward the pickup location.
  if robot-state = "to-pickup" [
    if current-order = nobody [
      set robot-state "idle"
      set target-patch nobody
      stop
    ]

    travel-one-step

    if member? robot-state ["broken" "waiting"] [
      stop
    ]

    if patch-here = target-patch [
      ask current-order [
        set order-status "picked"
      ]

      set target-patch [delivery-patch] of current-order
      set robot-state "carrying"
      set wait-streak 0
    ]

    stop
  ]

  ;; Carry the order to the delivery location.
  if robot-state = "carrying" [

    if current-order = nobody [
      set robot-state "idle"
      set target-patch nobody
      stop
    ]

    set target-patch [delivery-patch] of current-order

    travel-one-step

    if member? robot-state ["broken" "waiting"] [
      stop
    ]

    if patch-here = target-patch [

      ;; Notify the order module.
      complete-order current-order

      ;; Update robot workload.
      set orders-done orders-done + 1

      ;; Clear the completed task.
      set current-order nobody
      set target-patch nobody
      set wait-streak 0
      set robot-state "idle"

      ;; Recharge after completing the order if necessary.
      if battery <= 20 [
        send-to-charger
      ]
    ]

    stop
  ]

  ;; Waiting: retry the interrupted task.
  if robot-state = "waiting" [

    ;; Handle an empty battery.
    if battery <= 0 [
      break-robot self 5
      stop
    ]

    ;; Restore the interrupted task.
    ifelse current-order != nobody [

      ifelse [order-status] of current-order = "picked" [
        set robot-state "carrying"
        set target-patch [delivery-patch] of current-order
      ] [
        set robot-state "to-pickup"
        set target-patch [pickup-patch] of current-order
      ]

    ] [

      ifelse target-patch != nobody [
        ifelse [patch-type] of target-patch = "charger" [
          set robot-state "charging"
        ] [
          set robot-state "idle"
          set target-patch nobody
        ]
      ] [
        set robot-state "idle"
      ]
    ]

    ;; Retry movement without clearing wait-streak.
    if member? robot-state ["to-pickup" "carrying" "charging"] [
      travel-one-step
    ]

    stop
  ]

  ;; Charging: travel to charger or recharge.
  if robot-state = "charging" [

    ;; Select a charger when no destination is available.
    if target-patch = nobody [
      send-to-charger
    ]

    if target-patch = nobody [ stop ]

    ;; Select another charger if the current one is blocked.
    if [is-blocked?] of target-patch [
      set target-patch nobody
      send-to-charger
    ]

    if target-patch = nobody [ stop ]

    ifelse patch-here = target-patch [
      charge-battery
    ] [
      travel-one-step
    ]

    stop
  ]
end

;; Move one step and record robot energy and workload.

to travel-one-step
  if target-patch = nobody [ stop ]
  if patch-here = target-patch [ stop ]
  if robot-state = "broken" [ stop ]

  if battery <= 0 [
    break-robot self 5
    stop
  ]

  let previous-patch patch-here

  move-robot-step

  ;; Record a blocked movement attempt.
  if robot-state = "waiting" and patch-here = previous-patch [
    set wait-ticks wait-ticks + 1
    set total-wait-ticks total-wait-ticks + 1
  ]

  if patch-here != previous-patch [
    set distance-traveled distance-traveled + 1
    set active-ticks active-ticks + 1

    consume-battery 1

    ;; Record arrival at the charging station.
    if robot-state = "charging" and patch-here = target-patch [
      set charge-count charge-count + 1
    ]

    if battery <= 0 [
      if not (
        robot-state = "charging" and
        patch-here = target-patch
      ) [
        break-robot self 5
      ]
    ]
  ]
end
